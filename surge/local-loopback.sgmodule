#!name = Local Device Loopback & Tunnel (CoreDevice RSD)
#!desc = iPhone 本机自回环隧道支持。捕获发往 10.7.0.1 的配对数据流并反射，配合 Minis 用户态协议栈，把 10.7.0.1 反射回本机供 CDTK 使用（iOS 27.3 实测，更早版本未验证）。
#!category = Minis Toolkit
#!system = ios

[General]
tun-included-routes = %APPEND% 10.7.0.1/32
always-raw-tcp-keywords = %APPEND% "Content-Type: application/pairing+tlv8"

[IP Rewrite]
10.7.0.1 = reflect
