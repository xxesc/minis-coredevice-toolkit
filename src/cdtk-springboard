#!/usr/bin/env python3
"""
cdtk-springboard: iOS 原生桌面图标编排与文件夹分类管理工具
基于 CoreDevice RSD 底层通道与 SpringBoardServices 服务 (com.apple.springboardservices)
支持免电脑、免越狱导出、备份与下发自定义主屏布局 (setIconState)；下发后会回读校验，但 SpringBoard 可能对布局做规范化
"""

import argparse
import asyncio
import json
import os
import plistlib
import sys

from coredevice_session import CoreDeviceSession
from pymobiledevice3.services.springboard import SpringBoardServicesService

def validate_layout(layout):
    """下发前的最后一道闸：宁可拒绝，也不要用半成品布局覆盖主屏。"""
    problems = []
    if not isinstance(layout, list) or not layout:
        return ["根元素必须是非空列表（页面列表）"]
    total_icons = 0
    for i, page in enumerate(layout):
        if not isinstance(page, list):
            problems.append("第 %d 页不是列表" % (i + 1))
            continue
        total_icons += len(page)
        for j, item in enumerate(page):
            if isinstance(item, str):
                continue
            if isinstance(item, dict):
                if item.get("listType") == "folder":
                    subs = item.get("iconLists")
                    if not isinstance(subs, list) or not subs:
                        problems.append("第 %d 页第 %d 项是文件夹但 iconLists 缺失/为空" % (i + 1, j + 1))
                continue
            problems.append("第 %d 页第 %d 项类型非法: %s" % (i + 1, j + 1, type(item).__name__))
    if total_icons == 0:
        problems.append("整份布局里一个图标/组件都没有（下发了等于清空主屏）")
    return problems


def backup_path_for(src):
    """备份名带时间戳且绝不覆盖已有文件。"""
    import time
    stamp = time.strftime("%Y%m%d-%H%M%S")
    base = "%s.bak.%s.plist" % (src, stamp)
    n = 1
    while os.path.exists(base):
        n += 1
        base = "%s.bak.%s-%d.plist" % (src, stamp, n)
    return base


async def cmd_backup(args):
    dest = os.path.abspath(args.output)
    print(f"⚡ 正在通过 CoreDevice RSD 读取当前系统主屏布局...")
    async with CoreDeviceSession(args.pairing) as s:
        sb = SpringBoardServicesService(s.rsd)
        state = await sb.get_icon_state()
        
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        if dest.endswith(".json"):
            with open(dest, "w", encoding="utf-8") as f:
                json.dump(state, f, ensure_ascii=False, indent=2, default=str)
        else:
            with open(dest, "wb") as f:
                plistlib.dump(state, f)
                
        dock = state[0] if len(state) > 0 and isinstance(state[0], list) else []
        pages = state[1:] if len(state) > 1 else []
        
        folder_count = 0
        app_in_folder_count = 0
        standalone_apps = 0
        
        for p in pages:
            for item in p:
                if isinstance(item, dict) and item.get("listType") == "folder":
                    folder_count += 1
                    sub_lists = item.get("iconLists", [])
                    app_in_folder_count += sum(len(sub) for sub in sub_lists)
                else:
                    standalone_apps += 1
                
        print(f"✅ 主屏布局已成功备份至: {dest}")
        print(f"📊 统计: 共 {len(pages)} 个主屏幕页 + 1 个 Dock 栏 (包含 {len(dock)} 个固定图标)")
        print(f"📁 文件夹: 全机共 {folder_count} 个文件夹 (收纳 {app_in_folder_count} 个应用), 散落应用/组件 {standalone_apps} 个")

async def cmd_apply(args):
    src = os.path.abspath(args.input)
    if not os.path.exists(src):
        print(f"❌ 找不到布局文件: {src}", file=sys.stderr)
        sys.exit(1)

    if not args.yes:
        print(f"⚠️ [安全确认] 即将向 SpringBoard 覆盖下发全量桌面图标排布布局: {src}")
        try:
            confirm = input("确认执行覆盖生效吗？输入 [y/N]: ").strip().lower()
            if confirm not in ("y", "yes"):
                print("操作已取消。")
                return 2
        except (KeyboardInterrupt, EOFError):
            print("\n操作已取消。")
            return 2
        
    print(f"⚡ 正在加载布局文件: {src} ...")
    if src.endswith(".json"):
        with open(src, "r", encoding="utf-8") as f:
            new_layout = json.load(f)
    else:
        with open(src, "rb") as f:
            new_layout = plistlib.load(f)

    problems = validate_layout(new_layout)
    if problems:
        print("❌ 布局文件未通过安全检查，拒绝下发：", file=sys.stderr)
        for pr in problems[:8]:
            print("   • " + pr, file=sys.stderr)
        sys.exit(1)

    print("🚀 正在通过 com.apple.springboardservices 下发并热更新主屏布局...")
    async with CoreDeviceSession(args.pairing) as s:
        sb = SpringBoardServicesService(s.rsd)
        before = await sb.get_icon_state()
        bak = backup_path_for(src)
        with open(bak, "wb") as f:
            plistlib.dump(before, f)
        print(f"🛟 下发前已自动备份当前布局: {bak}")

        try:
            await sb.set_icon_state(new_layout)
        except Exception as e:
            print(f"❌ 下发失败: {e}；正在尝试用备份回滚…", file=sys.stderr)
            try:
                await sb.set_icon_state(before)
                print("🛟 已回滚到下发前的布局。", file=sys.stderr)
            except Exception as e2:
                print(f"⚠️  回滚也失败: {e2}；备份文件在 {bak}，可用 "
                      f"cdtk-springboard apply {bak} 手动恢复。", file=sys.stderr)
            return 1

        # set_icon_state 不回包，只能回读比对；SpringBoard 落盘有延迟，短轮询几次
        after = None
        for _ in range(5):
            after = await sb.get_icon_state()
            if after == new_layout:
                break
            await asyncio.sleep(0.4)
        if after == new_layout:
            print("🎉 桌面布局已生效（回读一致）。")
            return 0
        print("⚠️  下发后回读与目标布局不一致：SpringBoard 可能拒绝了这份布局，"
              "或对它做了规范化（去重/追加未列出的 App）。", file=sys.stderr)
        print(f"   当前实际布局已写入 {bak}.after.plist 供比对。", file=sys.stderr)
        with open(bak + ".after.plist", "wb") as f:
            plistlib.dump(after, f)
        return 1

def main():
    parser = argparse.ArgumentParser(
        prog="cdtk-springboard",
        description="cdtk-springboard: iOS 桌面图标与文件夹编排工具（可备份、可回读校验）"
    )
    parser.add_argument("--pairing", help="指定设备配对文件路径 (.plist)")
    subparsers = parser.add_subparsers(dest="cmd", required=True)

    p_backup = subparsers.add_parser("backup", help="导出并备份当前主屏布局")
    p_backup.add_argument("output", nargs="?", default="home_layout_backup.plist", help="保存路径 (默认 home_layout_backup.plist，支持 .json 或 .plist)")

    p_apply = subparsers.add_parser("apply", help="下发并应用指定主屏布局")
    p_apply.add_argument("input", help="要应用的布局文件路径 (.plist 或 .json)")
    p_apply.add_argument("-y", "--yes", action="store_true", help="跳过用户交互直接确认应用")

    args = parser.parse_args()
    if args.cmd == "backup":
        sys.exit(asyncio.run(cmd_backup(args)))
    elif args.cmd == "apply":
        sys.exit(asyncio.run(cmd_apply(args)))

if __name__ == "__main__":
    try:
        main()
    except SystemExit:
        raise
    except KeyboardInterrupt:
        sys.exit(130)
    except Exception as e:
        print(f"❌ {e}", file=sys.stderr)
        sys.exit(1)
