async def cmd_press(args):
    """点一个屏幕上有文字的控件。

    判据顺序经过一次修正：**以 OCR 为主**，元素树只作辅助。
    理由：元素树是滚动相关的、而且不完整——SwiftUI 会虚拟化，屏幕外的元素
    根本不在树里（实测同一屏有时 267 个、有时 21 个）。而 OCR 只看可见区域，
    恰好等于「能不能点」的判据。之前拿元素树当硬门槛，导致明明在屏幕上的
    元素也被拒绝。
    """
    # 0. --at x,y：手动坐标，跳过一切定位
    #    这是给纯图标按钮开的口子（返回 / 更多选项 / 拷贝 / 发送）——
    #    它们屏幕上没有文字，OCR 永远定位不到，只能靠人给坐标。
    if args.at:
        try:
            ax_, ay_ = [float(v) for v in args.at.replace("，", ",").split(",")]
        except ValueError:
            print(f"--at 格式应为 x,y（例：--at 117,180），收到 {args.at!r}", file=sys.stderr)
            return 1
        print(f"手动坐标 ({ax_:.0f}, {ay_:.0f})，跳过 OCR 定位")
        if args.dry_run:
            print("[dry-run] 不执行点击")
            return 0
        if args.no_settle:
            r = subprocess.run(["cdtk-ctrl", "tap", str(int(ax_)), str(int(ay_))],
                               capture_output=True, text=True, timeout=120)
            if r.returncode != 0:
                print(f"cdtk-ctrl tap 失败: {r.stderr[:300]}", file=sys.stderr)
                return 1
            print("已点击")
            return 0
        print("已点击 · " + await tap_and_settle(ax_, ay_))
        return 0

    if not args.text:
        print("要么给文字（press \"文字\"），要么给坐标（--at x,y）。", file=sys.stderr)
        return 1

    # 1. 定位（主判据是 OCR：看得见才点得到）
    scrolls = 0
    if args.scroll:
        got = await find_with_scroll(args.text, max_down=args.scroll,
                                     max_up=args.scroll * 2)
        if got is None:
            print(f"滚动搜索 {args.scroll*3} 次仍未找到 {args.text!r}，不点击。", file=sys.stderr)
            return 1
        text, cx, cy, scrolls, W, H = got
        hit = (text, cx, cy)
    else:
        items, (W, H) = await screenshot_and_ocr()
        hit = find_coord(items, args.text)
    if hit is None:
        # 屏幕上没有 → 用元素树给个更有用的诊断
        note = ""
        try:
            async with CoreDeviceSession() as s:
                async with AccessibilityAudit(s.rsd) as ax:
                    await ax._ensure_ready()
                    els = await collect_elements(ax, budget=12.0, app=getattr(args, "app", None),
                                                 want=args.text, want_mode=args.match)
            hits = [c for c, _ in els if match(c, args.text, args.match)]
            if hits:
                note = (f"\n元素树里有 {hits[0]!r}，但它不在当前可见区域——"
                        f"可能需要先滚动到它。")
            else:
                note = f"\n元素树（{len(els)} 个，仅当前屏）里也没有。"
        except Exception:
            pass
        print(f"屏幕上找不到 {args.text!r}，不点击。{note}", file=sys.stderr)
        return 1

    text, cx, cy = hit
    extra = f"（滚动 {scrolls} 次）" if scrolls else ""
    print(f"OCR 定位 {text!r} → ({cx:.0f}, {cy:.0f})  [屏幕 {W}x{H}]{extra}")

    if args.dry_run:
        print("[dry-run] 不执行点击")
        return 0

    # 2. 同一会话内：取基线帧 → 注入触摸 → 取后续帧
    #    必须在一个会话里做完，否则各自建隧道要 10s+，而且 settle 拿不到"点前"基线
    if args.no_settle:
        r = subprocess.run(["cdtk-ctrl", "tap", str(int(cx)), str(int(cy))],
                           capture_output=True, text=True, timeout=120)
        if r.returncode != 0:
            print(f"cdtk-ctrl tap 失败: {r.stderr[:300]}", file=sys.stderr)
            return 1
        print("已点击")
        return 0

    verdict = await tap_and_settle(cx, cy)
    print("已点击 · " + verdict)
    return 0


async def tap_and_settle(cx, cy, pre_sec=0.7, post_sec=1.5, fps=10):
    """取基线 → 点 → 取后续帧 → 判定屏幕有没有变、有没有稳。"""
    try:
        import cdtk_settle as S
        import cdtk_frames as F
        from pymobiledevice3.remote.core_device.hid_service import (
            touch_session, TOUCHSCREEN_STATE_CONTACT, TOUCHSCREEN_STATE_RELEASE,
        )
    except ImportError as e:
        return f"(settle 模块缺失: {e})"

    try:
        async with CoreDeviceSession() as s:
            # 基线：点之前
            pre = await F.grab_frames(s.rsd, duration=pre_sec, fps=fps)
            if not pre:
                return "(基线取帧失败)"
            base = F.frames_to_settle(pre)[-1]
            F.cleanup(pre)

            # 注入触摸（复用同一个 rsd，绝不起子进程 —— 会抢 flock 自锁）
            async with touch_session(s.rsd) as svc:
                hx = max(0, min(65535, int(cx / 1170 * 65535)))
                hy = max(0, min(65535, int(cy / 2532 * 65535)))
                await svc.send_touchscreen(TOUCHSCREEN_STATE_CONTACT, hx, hy)
                await asyncio.sleep(0.06)
                await svc.send_touchscreen(TOUCHSCREEN_STATE_RELEASE, hx, hy)

            # 点之后
            post = await F.grab_frames(s.rsd, duration=post_sec, fps=fps)
            if not post:
                return "(点后取帧失败)"
            frames = F.frames_to_settle(post)
            F.cleanup(post)
    except Exception as e:
        return f"(settle 出错: {type(e).__name__}: {str(e)[:60]})"

    d = S.diff(base, frames[0])
    # 末段是否静止：最后 3 帧两两比较
    tail = frames[-3:] if len(frames) >= 3 else frames
    stable = all(S.diff(tail[j], tail[j + 1]) < S.QUIET_SHARE for j in range(len(tail) - 1))

    parts = [("屏幕有变化" if d >= S.CHANGED_SHARE else "屏幕无变化（可能没点中）"),
             (f"变化 {d*100:.0f}%"),
             ("已静止" if stable else "仍在动"),
             f"帧数 {len(frames)}"]
    return " · ".join(parts)



async def cmd_input(args):
    """向输入框输入文本。

    **含空格或非 ASCII 的内容直接改走剪贴板**，不做键盘打字。
    理由是实测：键盘输入会被输入法改写——中文拼音态下空格被当成「确认候选词」
    吃掉、能拼成拼音的字母还会转成汉字（`aa bb cc` → `嗷嗷宝宝 cc`）；
    连第三方输入法的英文 QWERTY 态也会吞空格（`minis skills` → `minisskills`）。
    剪贴板粘贴完全绕开输入法，是唯一稳的路子。`--no-paste` 可强制走键盘。
    """
    if not args.no_paste and (" " in args.text or not args.text.isascii()):
        why = "含空格" if " " in args.text else "含非 ASCII 字符"
        print(f"文本{why} → 改走剪贴板粘贴（键盘输入会被输入法改写）")
        args.allow = True                 # 自动点掉「允许粘贴」授权框
        rc = await cmd_paste(args)
        if rc == 0 and args.submit:
            print("注意：粘贴路径不发回车。需要提交请另行 `cdtk-ui press \"前往\"`",
                  file=sys.stderr)
        return rc

    ok, bad = typeable(args.text)
    if not ok:
        print(f"这些字符不能用键盘输入：{bad!r}", file=sys.stderr)
        print("去掉 --no-paste 让它自动走剪贴板。", file=sys.stderr)
        return 1

    tgt = await resolve_target(args)
    if tgt is None:
        return 1
    label, px, py, W, H = tgt
    print(f"输入框 {label!r} @ ({px:.0f}, {py:.0f})")
    if args.dry_run:
        print(f"[dry-run] 将输入 {args.text!r}")
        return 0

    from pymobiledevice3.remote.core_device.hid_service import touch_session
    async with CoreDeviceSession() as s:
        async with touch_session(s.rsd) as svc:
            kb = await svc.create_keyboard_service()
            await hid_tap(svc, W, H, px, py)
            await asyncio.sleep(1.2)          # 等键盘弹出
            if args.clear:
                for _ in range(args.clear_len):
                    await svc.send_report(kb, build_kbd([KEY_DELETE]))
                    await asyncio.sleep(0.03)
                    await svc.send_report(kb, build_kbd([]))
                    await asyncio.sleep(0.03)
            await hid_type(svc, kb, args.text)
            if args.submit:
                await asyncio.sleep(0.15)
                await svc.send_report(kb, build_kbd([KEY_ENTER]))
                await asyncio.sleep(0.05)
                await svc.send_report(kb, build_kbd([]))
    print(f"已输入 {args.text!r}")

    # 回读校验：键盘打得对不对，只有看屏幕才知道。
    # 实测教训：键盘处于**中文拼音输入法**时，能拼成拼音的字母会被转成汉字
    # （输 "aa bb cc" 实际得到 "嗷嗷宝宝 cc"），空格还会被当成「确认候选词」
    # 吃掉（"minis skills" 变成 "minisskills"）。而 "openmins" 这种非法拼音
    # 反而原样保留 —— 所以「有时候能打对」最容易骗过人。
    if not args.no_verify:
        want = _norm(args.text)
        try:
            items2, _ = await screenshot_and_ocr()
            got = _norm("".join(t for t, _x, _y in items2))
            if want and want in got:
                print("回读校验：屏幕上已出现输入的文字 ✓")
            else:
                print("回读校验：屏幕上没找到输入的文字！很可能被输入法改写了"
                      "（中文拼音会把字母转成汉字，还会吃掉空格）。"
                      "建议改用 `cdtk-ui paste` 走剪贴板。", file=sys.stderr)
        except Exception as e:
            print(f"回读校验跳过（{type(e).__name__}）", file=sys.stderr)

    if args.submit:
        # 回车不一定真能提交：中文输入法下它常常被当成「确认候选词」吃掉。
        # 实测 Safari 地址栏打 openmins 后回车就没跳转，得点「前往」才走。
        # 静默失败最难查，所以这里必须报出来。
        await asyncio.sleep(0.8)
        try:
            import cdtk_frames as F
            async with CoreDeviceSession() as s2:
                pre = await F.grab_frames(s2.rsd, duration=0.6, fps=10)
                await asyncio.sleep(1.4)
                post = await F.grab_frames(s2.rsd, duration=0.6, fps=10)
            if pre and post:
                import cdtk_settle as S
                a = F.frames_to_settle(pre)[-1]
                b = F.frames_to_settle(post)[-1]
                d = S.diff(a, b)
                F.cleanup(pre); F.cleanup(post)
                if d >= S.CHANGED_SHARE:
                    print(f"回车已提交，界面有变化（{d*100:.0f}%）")
                else:
                    print("回车没有触发提交（界面没变）——很可能是中文输入法把回车"
                          "当成确认候选词了。请点页面上的「前往 / 搜索」按钮。")
            else:
                print("回车已发送（界面变化检测失败，请自行确认）")
        except Exception as e:
            print(f"回车已发送（检测跳过: {type(e).__name__}）")
    return 0


async def cmd_paste(args):
    """把文本写进剪贴板再 Cmd+V 粘贴。中文必须走这条。

    iOS 会弹「<App> 想从 <来源> 粘贴」授权框；--allow 会自动点「允许粘贴」。
    """
    print(f"写剪贴板: {args.text[:40]!r}")
    r = subprocess.run(["apple-clipboard", "set", "--text", args.text],
                       capture_output=True, text=True, timeout=120)
    if r.returncode != 0:
        print(f"apple-clipboard 失败: {r.stderr[:200]}", file=sys.stderr)
        return 1
    # 回读校验：解析 JSON 比对完整文本（直接子串匹配会被 JSON 转义坑到）
    ok_clip = False
    for _ in range(3):
        got = subprocess.run(["apple-clipboard", "get", "--compact"],
                             capture_output=True, text=True, timeout=120).stdout
        try:
            val = json.loads(got).get("data", {}).get("text")
        except (json.JSONDecodeError, AttributeError):
            val = None
        if val == args.text:
            ok_clip = True
            break
        time.sleep(0.3)
    if not ok_clip:
        print(f"剪贴板回读不一致（读到 {val!r}），中止", file=sys.stderr)
        return 1

    tgt = await resolve_target(args)
    if tgt is None:
        return 1
    label, px, py, W, H = tgt
    print(f"输入框 {label!r} @ ({px:.0f}, {py:.0f})")

    if args.dry_run:
        print("[dry-run] 不执行粘贴")
        return 0

    from pymobiledevice3.remote.core_device.hid_service import touch_session
    async with CoreDeviceSession() as s:
        async with touch_session(s.rsd) as svc:
            kb = await svc.create_keyboard_service()
            await hid_tap(svc, W, H, px, py)
            await asyncio.sleep(1.2)
            await hid_cmd_v(svc, kb)
            await asyncio.sleep(2.0)
            if args.allow:
                # 找「允许粘贴」并点它 —— 必须复用当前会话截图，
                # 另开 CoreDeviceSession 会 self-deadlock（同一把 flock）
                items, (W2, H2) = await screenshot_and_ocr_on(s.rsd)
                hit = find_coord(items, "允许粘贴")
                if hit:
                    _, ax_, ay_ = hit
                    print(f"授权框 → 点「允许粘贴」({ax_:.0f}, {ay_:.0f})")
                    await hid_tap(svc, W2, H2, ax_, ay_)
                else:
                    print("没有授权框（可能已记住选择）")

    # 落盘校验：Cmd+V 发出去不等于文字进了输入框。
    # 实测教训：豆包输入法会把 Cmd+V 收进它自己的「剪贴板候选条」，
    # 内容停在键盘上方那条里，输入框一个字都没有——而工具却照样打印
    # 「粘贴指令已发出」，看起来像成功。这种静默失败必须报出来。
    try:
        items2, _ = await screenshot_and_ocr()
        got = _norm("".join(t for t, _x, _y in items2))
        probe = _norm(args.text)[:20]
        if probe and probe in got:
            print("粘贴确认：文字已出现在屏幕上 ✓")
        else:
            print("粘贴未落进输入框！内容可能被输入法收进了它的剪贴板候选条"
                  "（键盘上方那一行），或剪贴板为空。"
                  "换用系统自带键盘，或手动点一下候选条。", file=sys.stderr)
            return 1
    except Exception as e:
        print(f"落盘校验跳过（{type(e).__name__}）", file=sys.stderr)

    print("粘贴指令已发出")
    return 0



def main():
    p = argparse.ArgumentParser(
        prog="cdtk-ui",
        description="用 CoreDevice 原生通道操作 iPhone 界面（元素树 + 截图 + OCR + 硬件点击）")
    sub = p.add_subparsers(dest="cmd", required=True)

    pt = sub.add_parser("tree", help="列出前台 App 的可聚焦元素")
    pt.add_argument("--json", action="store_true")
    pt.add_argument("--app", metavar="名称",
                    help="目标 App（bundle id 或可执行文件名片段，如 safari）。"
                         "不给就沿用上次读的那个 App——读错应用不会报错，建议显式指定")

    pf = sub.add_parser("find", help="按文本查找元素")
    pf.add_argument("text")
    pf.add_argument("--match", choices=["smart", "exact", "contains"], default="smart")
    pf.add_argument("--list-on-miss", action="store_true")
    pf.add_argument("--app", metavar="名称", help="目标 App（bundle id 或名称片段）")

    pp = sub.add_parser("press", help="点控件：按文字（OCR 定位）或按坐标（--at），点后判定界面是否稳定")
    pp.add_argument("text", nargs="?", help="要点击的文字；用 --at 时可省略")
    pp.add_argument("--at", metavar="X,Y",
                    help="直接点这个坐标（像素），跳过 OCR。给纯图标按钮用：返回/更多选项/拷贝/发送")
    pp.add_argument("--match", choices=["smart", "exact", "contains"], default="smart")
    pp.add_argument("--dry-run", action="store_true")
    pp.add_argument("--no-settle", action="store_true", help="点完不等待界面稳定")
    pp.add_argument("--app", metavar="名称", help="诊断用的目标 App（不影响 OCR 定位）")
    pp.add_argument("--scroll", type=int, default=0, metavar="N",
                    help="当前屏找不到就滚动搜索：先往更早找 N 次，再往更新找 2N 次")

    pg = sub.add_parser("grid", help="截图叠加坐标网格，方便给 --at 量位置")
    pg.add_argument("--step", type=int, default=100, help="网格间距（像素，默认 100）")
    pg.add_argument("--out", default="cdtk_grid.png", help="输出路径（默认 ./cdtk_grid.png）")

    pi = sub.add_parser("input", help="向输入框输入文本（虚拟键盘逐字符打字，仅 ASCII）")
    pi.add_argument("text")
    pi.add_argument("--into", help="目标输入框的标签（默认自动推算位置）")
    pi.add_argument("--at", help="手动指定坐标 x,y（像素）")
    pi.add_argument("--match", choices=["smart", "exact", "contains"], default="smart")
    pi.add_argument("--submit", action="store_true", help="输入后按回车")
    pi.add_argument("--no-verify", action="store_true", help="输入后不回读校验")
    pi.add_argument("--no-paste", action="store_true",
                    help="即使含空格/非 ASCII 也强制走键盘打字（默认自动改走剪贴板）")
    pi.add_argument("--clear", action="store_true", help="先按退格清空")
    pi.add_argument("--clear-len", type=int, default=30, help="退格次数（默认 30）")
    pi.add_argument("--dry-run", action="store_true")

    ppa = sub.add_parser("paste", help="把文本写进剪贴板并 Cmd+V 粘贴（中文用这个）")
    ppa.add_argument("text")
    ppa.add_argument("--into", help="目标输入框的标签")
    ppa.add_argument("--at", help="手动指定坐标 x,y（像素）")
    ppa.add_argument("--match", choices=["smart", "exact", "contains"], default="smart")
    ppa.add_argument("--allow", action="store_true", help="自动点「允许粘贴」授权框")
    ppa.add_argument("--dry-run", action="store_true")

    args = p.parse_args()
    handler = {"tree": cmd_tree, "find": cmd_find, "press": cmd_press,
               "grid": cmd_grid, "input": cmd_input, "paste": cmd_paste}[args.cmd]
    sys.exit(asyncio.run(handler(args)))


if __name__ == "__main__":
    main()
