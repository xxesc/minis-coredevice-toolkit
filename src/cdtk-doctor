    os.environ.get(k, "") for k in ("LANG", "LC_ALL", "LANGUAGE")
).lower()
is_zh = "--zh" in sys.argv or "--cn" in sys.argv or "zh" in lang_env

PASS = f"{GREEN}✅ [PASS]{RESET}" if not is_zh else f"{GREEN}✅ [通过]{RESET}"
